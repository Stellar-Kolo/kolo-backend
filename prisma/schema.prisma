datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                      String           @id @default(uuid())
  // Stores the AES-256-GCM JSON blob produced by encryptField(); plaintext
  // phone numbers never reach the database.
  phoneNumber             String?
  // HMAC-SHA256 of the plaintext phone number, used for lookups and to
  // enforce uniqueness on encrypted data. Nullable because users without a
  // stored phone number never get a hash.
  phoneNumberHash         String?          @unique
  username                String?          @unique
  stellarWallet           String?          @unique // JSON: {"publicKey":"...","encryptedSecret":"...","iv":"...","authTag":"...", "keyVersion": 1}
  encryptionKeyVersion    Int              @default(1)
  language                String           @default("en")
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  groups                  GroupMember[]
  contributions           Contribution[]
  withdrawals             Withdrawal[]
  sentPaymentRequests     PaymentRequest[] @relation("PaymentRequestRequester")
  receivedPaymentRequests PaymentRequest[] @relation("PaymentRequestResponder")
}

enum DeploymentStatus {
  PENDING
  DEPLOYING
  DEPLOYED
  FAILED
}

model SavingsGroup {
  id                     String           @id @default(uuid())
  name                   String
  contributionAmount     Decimal
  contributionFrequency  String // e.g., "WEEKLY", "MONTHLY"
  // Mirrors the Soroban contract's GroupType enum, passed to initialize().
  // Every group created through the current WhatsApp flow is "Rotational";
  // "GoalBased" is modeled here and on-chain but has no creation UX yet.
  groupType              String           @default("Rotational")
  targetAmount           Decimal? // GoalBased only; mirrors contract's target_amount
  lockUntilTarget        Boolean          @default(false)
  stellarContractId      String? // Soroban contract ID once deployed
  deploymentStatus       DeploymentStatus @default(PENDING)
  deploymentError        String?
  currentCycleStart      DateTime?
  currentCycleEnd        DateTime?
  bullMqJobId            String?
  payoutOrder            Json? // Ordered array of member userIds; defaults to join order when null
  currentPayoutIndex     Int              @default(0)
  totalCycles            Int              @default(0)
  payoutOrderLockedAt    DateTime? // Set once the first contribution of a cycle lands; blocks reordering
  deadlineExtensionsUsed Int              @default(0)
  // Set when the group drops below the 2-member minimum (see MemberExitLog /
  // GroupExitService). Blocks new contributions and scheduled reminders until
  // membership is restored.
  isPaused               Boolean          @default(false)
  pausedAt               DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  members                GroupMember[]
  Payout                 Payout[]
  PayoutOrderLog         PayoutOrderLog[]
  MemberExitLog          MemberExitLog[]
}

model GroupMember {
  id       String       @id @default(uuid())
  user     User         @relation(fields: [userId], references: [id])
  userId   String
  group    SavingsGroup @relation(fields: [groupId], references: [id])
  groupId  String
  role     String       @default("MEMBER") // e.g., "CREATOR", "MEMBER"
  // ACTIVE or LEFT. Soft-delete marker for voluntary exit / kick — the row is
  // kept for audit/history rather than removed.
  status   String       @default("ACTIVE")
  joinedAt DateTime     @default(now())
  leftAt   DateTime?

  @@unique([userId, groupId])
  @@index([userId])
  @@index([groupId])
}

model Contribution {
  id              String   @id @default(uuid())
  user            User     @relation(fields: [userId], references: [id])
  userId          String
  groupId         String
  amount          Decimal
  transactionHash String?
  status          String   @default("PENDING") // PENDING, COMPLETED, FAILED
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([groupId])
}

// GoalBased groups only — tracks withdraw_savings() calls so the
// reconciliation worker can subtract them from the DB-side contribution
// total, mirroring the on-chain total_contributions decrement.
model Withdrawal {
  id              String   @id @default(uuid())
  user            User     @relation(fields: [userId], references: [id])
  userId          String
  groupId         String
  amount          Decimal
  transactionHash String?
  status          String   @default("PENDING") // PENDING, COMPLETED, FAILED
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([groupId])
}

model Payout {
  id              String       @id @default(uuid())
  group           SavingsGroup @relation(fields: [groupId], references: [id])
  groupId         String
  recipientId     String
  amount          Decimal
  transactionHash String
  cycleNumber     Int
  status          String       @default("COMPLETED")
  createdAt       DateTime     @default(now())

  @@index([groupId])
  @@index([recipientId])
}

model PayoutOrderLog {
  id            String       @id @default(uuid())
  group         SavingsGroup @relation(fields: [groupId], references: [id])
  groupId       String
  changedBy     String
  previousOrder Json?
  newOrder      Json
  reason        String       @default("REORDER") // e.g., "REORDER", "SKIP_DEFAULT"
  createdAt     DateTime     @default(now())

  @@index([groupId])
}

model PaymentRequest {
  id              String   @id @default(uuid())
  requester       User     @relation("PaymentRequestRequester", fields: [requesterId], references: [id])
  requesterId     String
  responder       User     @relation("PaymentRequestResponder", fields: [responderId], references: [id])
  responderId     String
  amount          Decimal
  assetCode       String   @default("XLM")
  status          String   @default("PENDING") // PENDING, HOLDING, ACCEPTED, COMPLETING, DECLINED, EXPIRED, COMPLETED
  expiresAt       DateTime
  balanceId       String? // Stellar claimable balance ID once the hold is placed
  transactionHash String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([responderId, status])
  @@index([requesterId, status])
}

model SecretAccessLog {
  id           String   @id @default(uuid())
  userId       String
  operation    String // "SEND" | "CONTRIBUTE" | "TRUSTLINE" | "KEY_ROTATION"
  success      Boolean
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

/// Recorded whenever the contract-sync reconciliation worker detects that a
/// member's on-chain contribution amount differs from what the backend DB
/// shows for the current cycle.  Records are append-only and are NEVER
/// auto-resolved — they must be reviewed and closed by an admin.
model ReconciliationMismatch {
  id            String    @id @default(uuid())
  groupId       String
  userId        String
  /// Amount returned by the Soroban contract's get_contribution() (in stroops)
  onChainAmount Decimal
  /// Sum of COMPLETED Contribution records for this user+group in the current cycle
  dbAmount      Decimal
  detectedAt    DateTime  @default(now())
  resolvedAt    DateTime?
  resolvedBy    String? // userId of the admin who marked it resolved

  @@index([groupId])
  @@index([userId])
  @@index([detectedAt])
  @@index([resolvedAt])
}

/// Append-only settlement/audit record for a member's voluntary exit (LEAVE)
/// or removal (KICK). One row per exit — never updated.
model MemberExitLog {
  id               String       @id @default(uuid())
  group            SavingsGroup @relation(fields: [groupId], references: [id])
  groupId          String
  userId           String // the member who exited
  /// userId of who triggered the exit — the member themselves for LEAVE, the
  /// creator for KICK.
  initiatedBy      String
  type             String // "LEAVE" | "KICK"
  totalContributed Decimal
  totalReceived    Decimal
  /// totalContributed - totalReceived. Positive is refunded to the member;
  /// negative is a loss absorbed by the group (never charged back).
  netOwed          Decimal
  refundTxHash     String?
  createdAt        DateTime     @default(now())

  @@index([groupId])
  @@index([userId])
}
